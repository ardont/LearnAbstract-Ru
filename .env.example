# Токен бота MAX (получить у @BotFather в мессенджере MAX)
MAX_BOT_TOKEN=your_token_here

# Брокер событий Kafka (KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=education.events
KAFKA_TOPIC_DLQ=education.events.dlq

# База данных PostgreSQL (при отсутствии автоматически используется SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/education
SQLITE_URL=sqlite+aiosqlite:///./core.db

# Хранилище Redis для Rate Limiting и Watchdog (при отсутствии — in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting (запросов в минуту на одного ученика)
RATE_LIMIT_RPM=10

# Пакет Demo-Resilience (План «Б»)
# true = мгновенный академический ответ за 180 мс из локального вычитанного каталога
DEMO_MODE=false

# LLM Провайдер (при DEMO_MODE=false)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# Авторизация для дашборда учителя /teacher (HTTP Basic Auth)
TEACHER_USER=teacher
TEACHER_PASSWORD=change_me_in_production
